{
  "name": "monaco-json-studio",
  "version": "1.11.1",
  "description": "Generate a static Monaco JSON Studio with configurable pane headers, bodies, and footers.",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keshavsoft/monaco-json-studio.git"
  },
  "homepage": "https://keshavsoft.github.io/monaco-json-studio/",
  "type": "module",
  "main": "src/index.js",
  "module": "./src/index.js",
  "bin": {
    "monaco-json-studio": "bin/index.js",
    "create-monaco-studio": "bin/index.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "bin",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --check src/index.js && node --check bin/index.js",
    "dev:v6": "vite preview-v6/monaco-studio",
    "demo:v7": "node examples/npm-v7/generate-variations.mjs",
    "dev:v7": "vite preview-v7 --host 127.0.0.1 --port 5177",
    "sample:1": "node samples/single-pane/generate.mjs",
    "sample:2": "node samples/two-panes/generate.mjs",
    "sample:3": "node samples/three-panes/generate.mjs",
    "samples": "npm run sample:1 && npm run sample:2 && npm run sample:3"
  },
  "keywords": [
    "monaco",
    "monaco-editor",
    "json-visualizer",
    "static-generator",
    "scaffold",
    "json-studio",
    "declarative-ui",
    "keshavsoft"
  ],
  "author": "KeshavSoft",
  "license": "MIT",
  "dependencies": {
    "handlebars": "^4.7.10"
  },
  "devDependencies": {}
}
