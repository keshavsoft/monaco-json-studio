{
  "name": "monaco-json-studio",
  "version": "1.5.1",
  "description": "Generate a static Monaco JSON Studio by choosing one, two, or three panes.",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keshavsoft/monaco-json-studio.git"
  },
  "homepage": "https://keshavsoft.github.io/monaco-json-studio/",
  "type": "module",
  "main": "src/index.js",
  "module": "./src/index.js",
  "bin": {
    "monaco-json-studio": "bin/index.js",
    "create-monaco-studio": "bin/index.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "bin",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --check src/index.js && node --check bin/index.js",
    "dev:v6": "vite preview-v6/monaco-studio"
  },
  "keywords": [
    "monaco",
    "monaco-editor",
    "json-visualizer",
    "static-generator",
    "scaffold",
    "json-studio",
    "declarative-ui",
    "keshavsoft"
  ],
  "author": "KeshavSoft",
  "license": "MIT",
  "dependencies": {
    "handlebars": "^4.7.10"
  },
  "devDependencies": {
    "vite": "^8.3.8"
  }
}
