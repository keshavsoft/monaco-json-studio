<header class="pane-region pane-header pane-header--file-picker" data-region="header" data-type="file-picker">
    <div class="pane-header__left">
        <span class="pane-label">{{label}}</span>
        <button id="{{fileBtnId}}" type="button" class="btn-pane-file" title="Choose a file for {{label}}">
            <i class="bi bi-folder2-open" aria-hidden="true"></i>
            <span>Select File</span>
        </button>
        <input type="file" id="{{fileInputId}}" class="pane-file-input" accept=".json,.js,.txt,application/json">
    </div>
    <div class="pane-header__right">
        <span class="pane-file-pill">
            <i class="bi bi-filetype-json" aria-hidden="true"></i>
            <span id="{{fetchUrlId}}" class="pane-fetch-url">{{fetchUrl}}</span>
        </span>
    </div>
</header>
